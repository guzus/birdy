# Required: invite code users must enter in the web UI
BIRDY_HOST_INVITE_CODE=replace-with-long-random-secret

# Recommended for public deployments: block tweet/reply/follow/unfollow/unbookmark
BIRDY_READ_ONLY=1

# Optional: strict websocket origin allowlist (comma-separated)
# BIRDY_HOST_ALLOWED_ORIGINS=https://birdy.guzus.xyz,https://birdy-host-web-production.up.railway.app

# Optional: hide chat history UI and disable chat transcript persistence
BIRDY_TUI_HIDE_HISTORY=1

# Required for non-interactive account loading (JSON array)
# Keep this as one line in Railway variables.
BIRDY_ACCOUNTS=[{"name":"main","auth_token":"x_auth_token_here","ct0":"x_ct0_here"}]

# Required: E2B API access and the custom template built with
# `npm --prefix e2b-runner run template:build`.
E2B_API_KEY=e2b_replace-with-api-key
BIRDY_E2B_TEMPLATE=bird-box:production

# Optional: execution timeout overrides in milliseconds. Invalid combinations
# that exceed the six-minute HTTP budget or sandbox lifetime fail fast.
# BIRDY_E2B_COMMAND_TIMEOUT_MS=280000
# BIRDY_E2B_SANDBOX_TIMEOUT_MS=420000
# BIRDY_E2B_REQUEST_TIMEOUT_MS=30000

# Claude Code authentication (use OAuth token OR API key)
CLAUDE_CODE_OAUTH_TOKEN=replace-with-claude-code-oauth-token
# ANTHROPIC_API_KEY=replace-with-anthropic-api-key
# ANTHROPIC_AUTH_TOKEN=replace-with-anthropic-auth-token
